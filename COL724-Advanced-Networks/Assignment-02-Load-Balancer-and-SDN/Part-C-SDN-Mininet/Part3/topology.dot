graph RingTopology {
    layout=neato;
    overlap=false;
    splines=true;
    fontname="Helvetica";
    nodesep=0.9;
    ranksep=1.0;

    // default node and edge font settings
    node [fontsize=12, penwidth=1.3, fontname="Helvetica"];
    edge [fontsize=10, fontcolor="gray30", labelfloat=true, labeldistance=2.5, minlen=2];

    // === SWITCHES ===
    node [shape=circle, style=filled, fillcolor="#87CEFA"];
    s1 [pos="0,0!"];
    s2 [pos="3,0!"];
    s3 [pos="3,3!"];
    s4 [pos="0,3!"];

    // === HOSTS ===
    node [shape=box, style=rounded, fillcolor="#FFF8DC"];
    h1 [pos="0,-1.2!"];
    h2 [pos="5.3,0!"];
    h3 [pos="3,4.3!"];
    h4 [pos="-2.3,3!"];

    // === CONTROLLER ===
    node [shape=ellipse, style=filled, fillcolor="#FFDAB9"];
    c0 [label="Controller c0", pos="1.5,5!"];

    // === HOST LINKS (adjusted labels slightly offset) ===
    edge [labelfontsize=9, labelangle=30, labeldistance=1.2];
    h1 -- s1 [label="h1-eth0 : s1-eth1", labelangle=-25];
    h2 -- s2 [label="h2-eth0 : s2-eth1", labelangle=30, labeldistance=5.0];
    h3 -- s3 [label="h3-eth0 : s3-eth1", labelangle=90];
    h4 -- s4 [label="h4-eth0 : s4-eth1", labelangle=-60, labeldistance=5.0];

    // === SWITCH LINKS (with bandwidth + delay) ===
    edge [labelfontsize=10, labeldistance=2.2, labelangle=0];
    s1 -- s2 [label="s1-eth2 : s2-eth2\n2 Mbps, 10 ms"];
    s2 -- s3 [label="s2-eth3 : s3-eth2\n2 Mbps, 10 ms"];
    s3 -- s4 [label="s3-eth3 : s4-eth2\n1 Mbps, 20 ms"];
    s4 -- s1 [label="s4-eth3 : s1-eth3\n1 Mbps, 20 ms"];

    // === CONTROLLER LINKS (dashed) ===
    edge [style=dashed, color=gray70, fontcolor="gray50", fontsize=9];
    c0 -- s1 [label="ctrl"];
    c0 -- s2;
    c0 -- s3;
    c0 -- s4;
}
